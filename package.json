{
  "name": "lab7",
  "version": "1.0.0",
  "description": "Lab 7 - Sass/SCSS refactor of the lab 6 site",
  "scripts": {
    "build:dev": "sass --style=expanded --source-map scss/main.scss css/style.css",
    "build": "sass --style=compressed --no-source-map scss/main.scss css/style.css",
    "watch": "sass --watch --style=expanded --source-map scss/main.scss css/style.css",
    "clean": "rm -rf css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tuugii0526/web-development-lab7.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Tuugii0526/web-development-lab7/issues"
  },
  "homepage": "https://github.com/Tuugii0526/web-development-lab7#readme",
  "devDependencies": {
    "sass": "^1.105.1"
  }
}
